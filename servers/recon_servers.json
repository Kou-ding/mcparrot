{
    "mcpServers": {
        "nmap":{
            "command": "python3",
            "args": ["servers/nmap/NmapMCP.py"]
        },
        "gobuster":{
            "command": "python3",
            "args": ["servers/gobuster/GobusterMCP.py"]
        },
        "metasploit": {
            "command": "python3",
            "args": ["servers/metasploit/MetasploitMCP.py", "--transport", "stdio"]
        },
        "terminal": {
            "command": "python3",
            "args": ["servers/terminal/TerminalMCP.py"]
        }
    }
}
